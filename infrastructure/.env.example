# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/oc_logistics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=oc_logistics

# Redis
REDIS_URL=redis://redis:6379/0

# Storage (MinIO / S3)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=oc-logistics
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Auth
JWT_SECRET=changeme-use-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Seed user (used by scripts/seed.py)
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=changeme

# External integrations
ANTHROPIC_API_KEY=
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_CHANNEL_DISPATCH=C0123456789
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
OPENCLAW_BACKEND_BASE_URL=http://localhost:8000
OPENCLAW_GATEWAY_TOKEN=  # Token from ~/.openclaw/openclaw.json gateway.auth.token
